#
set xlabel "neutron energy [eV]"
set ylabel "neutron flux dn/dlog(E) [n/7e12p]"

set xrange [*:*]; set yrange [*:*]
stats "data/NEAR-MCecc" u (($2-$1)*$3) nooutput
nn1=STATS_sum

set xrange [*:*]; set yrange [*:*]
stats "data/NEAR-SK-nomod" u (($2-$1)*$3) nooutput
nn2=STATS_sum

set xrange [*:*]; set yrange [*:*]
stats "data/NEAR-SK-wmod" u (($2-$1)*$3) nooutput
nn3=STATS_sum

lab1=sprintf("MCecc: %5.2e n/7e12p",nn1)
lab2=sprintf("SK-nomod: %5.2e n/7e12p",nn2)
lab3=sprintf("SK-wmod: %5.2e n/7e12p",nn3)

set key left
set logscale
set yrange [10000:]
set format x "10^{%T}"
set xtics 10

set title "NEAR Station neutron spectra"
plot "data/NEAR-MCecc"   u 1:($3*sqrt($1*$2)) w steps lw 3 lt 1 t lab1,\
     "data/NEAR-SK-nomod"   u 1:($3*sqrt($1*$2)) w steps lw 3 lt 2 t lab2

#     "data/NEAR-SK-wmod" u 1:($3*sqrt($1*$2)) w steps lw 2 lt 4 t lab3



