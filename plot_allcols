set grid
set key left
set logscale x
set xrange [:100.e+6]
set xtics 10
set format x "10^{%T}"
set ytics nomirror
set xlabel "neutron energy [eV]"
set ylabel "neutron flux dn/dlog(E) [n/cm2/E+12p]"
unset logscale y2
set y2tics 0.1
set y2range [0:1]
set y2label "cumulative SACS"


stats fln u (($2-$1)*$3) nooutput; nn=STATS_sum
stats fln u (($2-$1)*$4) nooutput; fnn=STATS_sum
stats fln u (($2-$1)*$5) nooutput; ssfnn=STATS_sum
stats fln u (($2-$1)*$5) nooutput; mbnn=STATS_sum

stats fln u (($2-$1)*$3*$7) nooutput; sacs=STATS_sum/nn
stats fln u (($2-$1)*$4*$7) nooutput; fsacs=STATS_sum/fnn
stats fln u (($2-$1)*$5*$7) nooutput; ssfsacs=STATS_sum/ssfnn
stats fln u (($2-$1)*$6*$7) nooutput; mbsacs=STATS_sum/mbnn

