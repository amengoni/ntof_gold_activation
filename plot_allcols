prt=sprintf("f-SACS  [b]: %8.3f",fsacs); print prt
prt=sprintf("f-SACS  [b]: %8.3f (self-shielded)",ssfsacs); print prt

plot fln u ($1):($4) w steps lw 2 lt 1 t"f-nflux",\
     fln u ($1):($6) w steps lw 2 lt 2 t"m-nflux",\
