#
macs_fun(kT,sig,E)     = 2./sqrt(pi)*(1./kT**2)*E*sig*exp(-E/kT)
msacs_fun(kT,xs,E)      = (1./kT**2)*E*xs*exp(-E/kT)
msacs_int(kT,xs,E1,E2) = xs*(1./kT)*((E1+kT)*exp(-E1/kT) - (E2+kT)*exp(-E2/kT))
step_fun(kT,fw,E)      = (E > kT*(1.-0.25*fw) && E < kT*(1.+10.00*fw) ? 1.0 : 0.0)

set fit quiet
